---
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ChibiWidget from './ChibiWidget.astro';
import ImageZoom from './ImageZoom.astro';
import AnchorCopy from './AnchorCopy.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

{/* (STARLIGHT-THEME-OBSIDIAN): Do not show header component if page has no sidebar, create a separate mobile-header component */}
<div class="page sl-flex">
    {
        hasSidebar ? (
            <nav class="sidebar" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
                <script>
                    // (STARLIGHT 0.42): The mobile menu uses the popover API to open and close without JavaScript.
                    // We enhance this behaviour with focus trapping while the menu is open.
                    class StarlightSidebarPane extends HTMLElement {
                        constructor() {
                            super();

                            const desktopMediaQuery = matchMedia('(min-width: 50em)');

                            // Remove the popover attribute on desktop viewports. It's only needed for the mobile menu.
                            const resetPopoverAttribute = () => {
                                this.popover = desktopMediaQuery.matches ? null : 'auto';
                            }
                            resetPopoverAttribute();
                            desktopMediaQuery.addEventListener('change', () => resetPopoverAttribute());

                            // Update the menu state when the sidebar popover is toggled.
                            this.addEventListener('toggle', (e: ToggleEvent) => this.trapFocus(e.newState === 'open'));
                        }
                        /** Trap keyboard focus inside the header and menu when the menu is expanded. */
                        trapFocus(shouldTrap: boolean) {
                            document.querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link').forEach((el) => {
                                el.toggleAttribute('inert', shouldTrap);
                            });
                        }
                    }
                    if (!customElements.get('sl-sidebar-pane')) {
                        customElements.define('sl-sidebar-pane', StarlightSidebarPane);
                    }
                </script>
                <sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
                    <div class="sidebar-content sl-flex">
                        <slot name="sidebar" />
                    </div>
                </sl-sidebar-pane>
            </nav>
        ) : (<header class="header"><slot name="header" /></header>)
    }
    {hasSidebar && (
        <div class="mobile-header">
            <div class="title-wrapper ">
                <SiteTitle/>
            </div>
            <MobileTableOfContents/>
            <MobileMenuToggle/>
        </div>
    )}
    <div class="main-frame">
        <slot />
    </div>
</div>

<ChibiWidget {...Astro.props} />
<ImageZoom />
<AnchorCopy />

<style>
	@layer starlight.core {
		.page {
			flex-direction: column;
			min-height: 100vh;
		}

		.header {
			z-index: var(--sl-z-index-navbar);
			position: fixed;
			inset-inline-start: 0;
			inset-block-start: 0;
			width: 100%;
			height: var(--sl-nav-height);
			border-bottom: none;
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			padding-inline-end: var(--sl-nav-pad-x);
			background-color: var(--sl-color-bg-sidebar);
		}

		:global([data-has-sidebar]) .header {
			padding-inline-end: calc(
				var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
			);
		}

		.sidebar-pane {
			/* (STARLIGHT 0.42): By default, user agents apply opinionated styles to popovers, which we don't want. */
			border: unset;
			padding: unset;
			height: unset;
			color: unset;
			position: fixed;
			z-index: var(--sl-z-index-menu);
			inset-block: var(--sl-nav-height) 0;
			inset-inline-start: 0;
			width: 100%;
			background-color: var(--sl-color-black);
			overflow-y: auto;
		}

		.sidebar-content {
			height: 100%;
			min-height: max-content;
			padding: 0 var(--sl-sidebar-pad-x) 0;
			flex-direction: column;
			gap: 1rem;
		}

		@media (min-width: 50rem) {
			.sidebar-content::after {
				content: '';
				padding-bottom: 1px;
			}
		}

		.main-frame {
			padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
			padding-inline-start: var(--sl-content-inline-start);
		}

		@media (min-width: 50rem) {
			:global([data-has-sidebar]) .header {
				padding-inline-end: var(--sl-nav-pad-x);
			}
			.sidebar-pane {
				/* Make the sidebar visible on larger screens instead of deferring to popover state. */
				display: block;
				width: var(--sl-sidebar-width);
				background-color: var(--sl-color-bg-sidebar);
				border-inline-end: 1px solid var(--sl-color-hairline);
			}
		}
	}
</style>
