---
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import ChibiWidget from './ChibiWidget.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

{/* (STARLIGHT-THEME-OBSIDIAN): Header component with mobile controls */}
<div class="page sl-flex">
    {
        hasSidebar ? (
            <nav class="sidebar" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
                <div id="starlight__sidebar" class="sidebar-pane">
                    <div class="sidebar-content sl-flex">
                        <slot name="sidebar" />
                    </div>
                </div>
            </nav>
        ) : (<header class="header"><slot name="header" /></header>)
    }
    <div class="main-frame">
        {hasSidebar && (
            <div class="mobile-header">
                <div class="title-wrapper">
                    <SiteTitle/>
                </div>
                <div class="mobile-controls sl-flex">
                    <ThemeSelect />
                    <LanguageSelect />
                </div>
                <MobileTableOfContents/>
                <MobileMenuToggle/>
            </div>
        )}
        <slot />
    </div>
</div>

<ChibiWidget {...Astro.props} />

<style>
	@layer starlight.core {
		.page {
			flex-direction: column;
			min-height: 100vh;
		}

		.header {
			z-index: var(--sl-z-index-navbar);
			position: fixed;
			inset-inline-start: 0;
			inset-block-start: 0;
			width: 100%;
			height: var(--sl-nav-height);
			border-bottom: 1px solid var(--sl-color-hairline);
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			padding-inline-end: var(--sl-nav-pad-x);
			background-color: rgba(20, 16, 34, 0.75);
			backdrop-filter: blur(14px);
			-webkit-backdrop-filter: blur(14px);
		}

		:global([data-theme='light']) .header {
			background-color: rgba(250, 248, 255, 0.85);
		}

		:global([data-has-sidebar]) .header {
			padding-inline-end: calc(
				var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
			);
		}

		.sidebar-pane {
			visibility: var(--sl-sidebar-visibility, hidden);
			position: fixed;
			z-index: var(--sl-z-index-menu);
			inset-block: 0;
			inset-inline-start: 0;
			width: 100%;
			background-color: var(--sl-color-bg-sidebar);
			overflow-y: auto;
		}

		:global([aria-expanded='true']) ~ .sidebar-pane {
			--sl-sidebar-visibility: visible;
		}

		.sidebar-content {
			height: 100%;
			min-height: max-content;
			padding: 1rem var(--sl-sidebar-pad-x) 1rem;
			flex-direction: column;
			gap: 1rem;
		}

		@media (min-width: 50rem) {
			.sidebar-content::after {
				content: '';
				padding-bottom: 1px;
			}
		}

		.main-frame {
			padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
			padding-inline-start: var(--sl-content-inline-start);
		}

		.mobile-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			height: var(--sl-nav-height);
			background-color: rgba(20, 16, 34, 0.85);
			backdrop-filter: blur(14px);
			-webkit-backdrop-filter: blur(14px);
			border-bottom: 1px solid var(--sl-color-hairline);
			padding: 0 var(--sl-nav-pad-x);
			z-index: var(--sl-z-index-navbar);
		}

		.mobile-controls {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

		@media (min-width: 50rem) {
			.mobile-header {
				display: none;
			}
			:global([data-has-sidebar]) .header {
				padding-inline-end: var(--sl-nav-pad-x);
			}
			.sidebar-pane {
				--sl-sidebar-visibility: visible;
				width: var(--sl-sidebar-width);
				background-color: var(--sl-color-bg-sidebar);
				border-inline-end: 1px solid var(--sl-color-hairline);
			}
			:global([data-has-sidebar]) .main-frame {
				padding-top: 1.5rem;
			}
			:global(:not([data-has-sidebar])) .main-frame {
				padding-top: var(--sl-nav-height);
			}
		}
	}
</style>
