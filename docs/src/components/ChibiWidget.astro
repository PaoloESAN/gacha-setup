---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import defaultHouston from '../assets/houston.webp';

const globChibis = import.meta.glob<{ default: ImageMetadata }>('../assets/chibis/**/*.{png,jpg,jpeg,webp,svg}', { eager: true });

const CHIBI_MAP: Record<string, ImageMetadata> = {};

for (const path in globChibis) {
  const match = path.match(/chibis\/(.+)\.(png|jpg|jpeg|webp|svg)$/i);
  if (match) {
    const fullPathKey = match[1].toLowerCase();
    const fileNameKey = match[1].split('/').pop()!.toLowerCase();

    CHIBI_MAP[fullPathKey] = globChibis[path].default;
    CHIBI_MAP[fileNameKey] = globChibis[path].default;
  }
}

const routeEntry = Astro.locals?.starlightRoute?.entry;
const chibiName = (Astro.props?.chibi || routeEntry?.data?.chibi || '').toLowerCase().trim();

const selectedImage = CHIBI_MAP[chibiName] || defaultHouston;
---

<div class="gacha-chibi-container">
  <Image
    src={selectedImage}
    alt="Chibi"
    class="chibi-static-img"
    loading="eager"
  />
</div>

<style>
  .gacha-chibi-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 100;
  }

  .chibi-static-img {
    display: block;
    width: 240px;
    height: 240px;
    object-fit: contain;
    cursor: grab;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.3s ease;
    user-select: none;
    -webkit-user-drag: none;
  }

  .chibi-static-img:hover {
    transform: scale(1.15) translateY(-4px) rotate(-2deg);
  }

  @media (max-width: 768px) {
    .gacha-chibi-container {
      bottom: 16px;
      right: 16px;
    }
    .chibi-static-img {
      width: 90px;
      height: 90px;
    }
  }
</style>
