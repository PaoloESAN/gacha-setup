---
import Default from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';

const isHomepage = /^\/(?:es\/?|id\/?)?$/.test(Astro.url.pathname);
---

<Default {...Astro.props } transition:animate="none">
    <slot />
</Default>

{isHomepage && (
	<script type="application/ld+json" set:html={JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Gacha Setup for Blender',
		alternateName: 'Gacha Setup',
		url: 'https://gacha-setup.pages.dev/',
	})} />
)}

<ClientRouter fallback="swap" />

<script>
	import { pagefindUserConfig } from 'virtual:starlight/pagefind-config';

	const gladiusProfiles = new Set([
		'https://www.patreon.com/cw/GladiusTyrfing',
		'https://x.com/Gladius_Tyrfing',
	]);

	function confirmGladiusProfile(event: MouseEvent) {
		if (event.type === 'auxclick' && event.button !== 1) return;
		const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
		if (!(link instanceof HTMLAnchorElement) || !gladiusProfiles.has(link.href)) return;
		event.preventDefault();
		event.stopImmediatePropagation();
		if (document.querySelector('.profile-notice')) return;

		const spanish = document.documentElement.lang.startsWith('es');
		const indonesian = document.documentElement.lang.startsWith('id');
		const dialog = document.createElement('dialog');
		dialog.className = 'profile-notice';
		dialog.setAttribute('aria-labelledby', 'profile-notice-title');
		dialog.setAttribute('aria-describedby', 'profile-notice-description');
		dialog.innerHTML = `
			<div class="profile-notice-badge" aria-hidden="true">18+</div>
			<h2 id="profile-notice-title"></h2>
			<p id="profile-notice-description"></p>
			<div class="profile-notice-actions">
				<button type="button" data-cancel autofocus></button>
				<button type="button" data-continue></button>
			</div>`;
		dialog.querySelector('h2')!.textContent = indonesian ? 'Konten dewasa' : spanish ? 'Contenido para adultos' : 'Adult content';
		dialog.querySelector('p')!.textContent = spanish
			? 'El siguiente perfil contiene contenido +18. ¿Deseas continuar?'
			: indonesian ? 'Profil berikut berisi konten 18+. Apakah Anda ingin melanjutkan?' : 'The following profile contains 18+ content. Do you wish to continue?';
		const cancel = dialog.querySelector<HTMLButtonElement>('[data-cancel]')!;
		const proceed = dialog.querySelector<HTMLButtonElement>('[data-continue]')!;
		cancel.textContent = indonesian ? 'Batal' : spanish ? 'Cancelar' : 'Cancel';
		proceed.textContent = indonesian ? 'Lanjutkan' : spanish ? 'Continuar' : 'Continue';
		cancel.addEventListener('click', () => dialog.close());
		const openNewTab = link.target === '_blank' || event.ctrlKey || event.metaKey || event.shiftKey || event.button === 1;
		proceed.addEventListener('click', () => {
			dialog.close();
			if (openNewTab) window.open(link.href, '_blank', 'noopener,noreferrer');
			else window.location.assign(link.href);
		});
		dialog.addEventListener('click', (click) => {
			const bounds = dialog.getBoundingClientRect();
			if (click.target === dialog && (click.clientX < bounds.left || click.clientX > bounds.right || click.clientY < bounds.top || click.clientY > bounds.bottom)) dialog.close();
		});
		const closeOnNavigation = () => dialog.close();
		document.addEventListener('astro:before-swap', closeOnNavigation, { once: true });
		dialog.addEventListener('close', () => {
			document.removeEventListener('astro:before-swap', closeOnNavigation);
			dialog.remove();
			if (link.isConnected) link.focus();
		}, { once: true });
		document.body.append(dialog);
		dialog.showModal();
	}

	document.addEventListener('click', confirmGladiusProfile, true);
	document.addEventListener('auxclick', confirmGladiusProfile, true);

	document.addEventListener('astro:page-load', () => {
		const videos = document.querySelectorAll<HTMLVideoElement>('video:not([data-lazy-video-ready])');
		const loadVideo = (video: HTMLVideoElement) => {
			if (video.dataset.lazyVideoReady) return;
			video.dataset.lazyVideoReady = 'true';
			video.load();
		};

		if ('IntersectionObserver' in window) {
			const videoObserver = new IntersectionObserver((entries, observer) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						loadVideo(entry.target as HTMLVideoElement);
						observer.unobserve(entry.target);
					}
				}
			}, { rootMargin: '300px 0px' });

			videos.forEach((video) => videoObserver.observe(video));
		} else {
			videos.forEach(loadVideo);
		}

		const siteSearch = document.querySelector('site-search');
		if (!siteSearch) return;

		const openBtn = siteSearch.querySelector<HTMLButtonElement>('button[data-open-modal]');
		const closeBtn = siteSearch.querySelector<HTMLButtonElement>('button[data-close-modal]');
		const dialog = siteSearch.querySelector<HTMLDialogElement>('dialog');
		const dialogFrame = siteSearch.querySelector<HTMLElement>('.dialog-frame');

		if (!openBtn || !closeBtn || !dialog || !dialogFrame) return;

		// 1. Ensure trigger button is enabled and show shortcut badge
		openBtn.disabled = false;
		const shortcut = openBtn.querySelector<HTMLElement>('kbd');
		if (shortcut) {
			const platformKey = shortcut.querySelector('kbd');
			if (platformKey && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
				platformKey.textContent = '⌘';
				openBtn.setAttribute('aria-keyshortcuts', 'Meta+K');
			}
			shortcut.style.display = '';
		}

		// 2. Setup click outside to close modal
		const onClickOutside = (event: MouseEvent) => {
			const isLink = 'href' in (event.target || {});
			if (
				isLink ||
				(document.body.contains(event.target as Node) &&
					!dialogFrame.contains(event.target as Node))
			) {
				closeModal();
			}
		};

		const openModal = (event?: MouseEvent) => {
			if (typeof dialog.showModal === 'function') {
				dialog.showModal();
			} else {
				dialog.setAttribute('open', '');
			}
			document.body.toggleAttribute('data-search-modal-open', true);
			siteSearch.querySelector<HTMLInputElement>('input')?.focus();
			event?.stopPropagation();
			window.addEventListener('click', onClickOutside);
		};

		const closeModal = () => {
			if (typeof dialog.close === 'function') {
				dialog.close();
			} else {
				dialog.removeAttribute('open');
			}
		};

		openBtn.onclick = (e) => openModal(e);
		closeBtn.onclick = () => closeModal();
		dialog.onclose = () => {
			document.body.toggleAttribute('data-search-modal-open', false);
			window.removeEventListener('click', onClickOutside);
		};

		// 3. Setup Ctrl+K / Cmd+K keydown listener globally
		if (!(window as any).__starlight_search_keydown_registered) {
			(window as any).__starlight_search_keydown_registered = true;
			window.addEventListener('keydown', (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
					const activeSearch = document.querySelector('site-search');
					const activeDialog = activeSearch?.querySelector<HTMLDialogElement>('dialog');
					if (activeDialog) {
						if (activeDialog.open) {
							if (typeof activeDialog.close === 'function') activeDialog.close();
							else activeDialog.removeAttribute('open');
						} else {
							if (typeof activeDialog.showModal === 'function') activeDialog.showModal();
							else activeDialog.setAttribute('open', '');
							document.body.toggleAttribute('data-search-modal-open', true);
							activeSearch?.querySelector<HTMLInputElement>('input')?.focus();
						}
					}
					e.preventDefault();
				}
			});
		}

		// 4. Initialize Pagefind UI if container is empty
		if (import.meta.env.DEV) return;
		const container = siteSearch.querySelector('#starlight__search');
		if (!container || container.children.length > 0) return;

		let translations = {};
		try {
			translations = JSON.parse((siteSearch as HTMLElement).dataset.translations || '{}');
		} catch {}

		const shouldStrip = (siteSearch as HTMLElement).dataset.stripTrailingSlash !== undefined;
		const stripTrailingSlash = (path: string) => path.replace(/(.)\/(#.*)?$/, '$1$2');
		const formatURL = shouldStrip ? stripTrailingSlash : (path: string) => path;

		const onIdle = window.requestIdleCallback || ((cb) => setTimeout(cb, 1));
		onIdle(async () => {
			if (container.children.length > 0) return;
			try {
				let PagefindUI = (window as any).PagefindUI;
				if (!PagefindUI) {
					const pagefindUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/pagefind-ui.js`;
					const mod = await import(/* @vite-ignore */ pagefindUrl);
					PagefindUI = mod.PagefindUI || (window as any).PagefindUI;
				}
				if (PagefindUI && container.children.length === 0) {
					new PagefindUI({
						...pagefindUserConfig,
						element: '#starlight__search',
						baseUrl: import.meta.env.BASE_URL,
						bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
						showImages: false,
						translations,
						showSubResults: true,
						processResult: (result: { url: string; sub_results: Array<{ url: string }> }) => {
							result.url = formatURL(result.url);
							result.sub_results = result.sub_results.map((sub_result) => {
								sub_result.url = formatURL(sub_result.url);
								return sub_result;
							});
						},
					});
				}
			} catch (err) {
				console.error('Failed to initialize PagefindUI on page-load:', err);
			}
		});
	});
</script>

<style is:global>
	.profile-notice {
		box-sizing: border-box;
		width: min(28rem, calc(100vw - 2rem));
		margin: auto;
		padding: 2rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1.25rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-white);
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
	}
	.profile-notice::backdrop {
		background: rgba(0, 0, 0, 0.65);
		backdrop-filter: blur(5px);
	}
	.profile-notice-badge {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 0.85rem;
		background: rgba(255, 112, 36, 0.14);
		color: #ff7024;
		font-size: 1.1rem;
		font-weight: 800;
	}
	.profile-notice h2 { margin: 1.25rem 0 0.75rem; font-size: 1.4rem; line-height: 1.3; }
	.profile-notice p { margin: 0; color: var(--sl-color-gray-2); line-height: 1.65; }
	.profile-notice-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.75rem; margin-top: 1.75rem; }
	.profile-notice button {
		padding: 0.65rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.65rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.profile-notice [data-continue] { background: #ff7024; border-color: #ff7024; color: #17100b; }
	.profile-notice button:hover { filter: brightness(1.1); }
	.profile-notice button:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
</style>
