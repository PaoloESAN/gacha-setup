---
import TableOfContents from 'virtual:starlight/components/TableOfContents';
---

{
	Astro.locals.starlightRoute.toc && (
	<>
		<div class="right-sidebar-panel sl-hidden lg:sl-block">
			{/* (STARLIGHT-THEME-OBSIDIAN): Removed mobile ToC, moved to PageFrame */}
			<div class="sl-container">
				<TableOfContents/>
			</div>
		</div>
	</>
		)
	}


<style>
	@layer starlight.core {
		.right-sidebar-panel {
			padding: 3rem var(--sl-sidebar-pad-x) 1.25rem;
			max-height: 100vh;
			overflow-y: auto;
			overflow-x: hidden;
		}
		.sl-container {
			width: 100%;
		}
		.right-sidebar-panel :global(h2) {
			color: var(--sl-color-white);
			font-size: 1.05rem;
			font-weight: 650;
			line-height: var(--sl-line-height-headings);
			margin-bottom: 0.75rem;
			display: flex;
			align-items: center;
			gap: 0.55rem;
		}
		.right-sidebar-panel :global(h2)::before {
			content: '☰';
			color: var(--sl-color-gray-3);
			font-size: 0.85em;
			font-weight: 400;
		}
		.right-sidebar-panel :global(:where(a)) {
			display: block;
			font-size: 0.9rem;
			line-height: 1.45;
			padding-block: 0.28rem;
			text-decoration: none;
			color: var(--sl-color-gray-3);
			overflow-wrap: anywhere;
		}
		.right-sidebar-panel :global(:where(a):hover) {
			color: var(--sl-color-white);
		}
		.right-sidebar-panel :global(a[aria-current='true']) {
			color: var(--sl-color-accent-high);
			font-weight: 650;
		}
		.right-sidebar-panel :global(ul ul a) {
			font-size: 0.85rem;
			padding-block: 0.2rem;
		}
		@media (min-width: 72rem) {
			.sl-container {
				max-width: calc(
					(
					(
					100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 *
					var(--sl-sidebar-pad-x)
					) * 0.25 /* MAGIC NUMBER 🥲 */
					)
				);
			}
		}
	}
</style>
