---
import TableOfContents from 'virtual:starlight/components/TableOfContents';
---

{
	Astro.locals.starlightRoute.toc && (
	<>
		<div class="right-sidebar-panel sl-hidden lg:sl-block">
			<div class="sl-container">
				<TableOfContents/>
			</div>
		</div>
	</>
	)
}

<style>
	@layer starlight.core {
		.right-sidebar-panel {
			padding: 1rem var(--sl-sidebar-pad-x);
		}
		.sl-container {
			width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
		}
		.right-sidebar-panel :global(h2) {
			color: var(--sl-color-white);
			font-size: var(--sl-text-h5);
			font-weight: 700;
			line-height: var(--sl-line-height-headings);
			margin-bottom: 0.75rem;
		}
		.right-sidebar-panel :global(:where(a)) {
			display: block;
			font-size: var(--sl-text-xs);
			text-decoration: none;
			color: var(--sl-color-gray-3);
			padding: 0.3rem 0.6rem;
			border-radius: 8px;
			transition: all 0.2s ease;
			overflow-wrap: anywhere;
		}
		.right-sidebar-panel :global(:where(a):hover) {
			color: var(--sl-color-white);
			background-color: rgba(255, 255, 255, 0.06);
		}
		.right-sidebar-panel :global(:where(a[aria-current="true"])) {
			color: var(--sl-color-white) !important;
			background-color: rgba(255, 255, 255, 0.1) !important;
			border-radius: 8px;
			font-weight: 600;
		}
		:global([data-theme='light']) .right-sidebar-panel :global(:where(a[aria-current="true"])) {
			color: #0f172a !important;
			background-color: rgba(124, 58, 237, 0.09) !important;
			font-weight: 700;
		}
		@media (min-width: 72rem) {
			.sl-container {
				max-width: calc(
					(
					(
					100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 *
					var(--sl-sidebar-pad-x)
					) * 0.25
					)
				);
			}
		}
	}
</style>
